{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": "siquitour",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.siquitour.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow SiquiTour to access your camera to capture driver's license photos for verification.",
        "NSPhotoLibraryUsageDescription": "Allow SiquiTour to access your photos for driver's license verification.",
        "NSPhotoLibraryAddUsageDescription": "Allow SiquiTour to save photos from your camera."
      }
    },
    "android": {
      "package": "com.siquitour.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos for driver's license verification",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to capture driver's license photos"
        }
      ]
    ],
    "permissions": [
      "CAMERA",
      "READ_EXTERNAL_STORAGE",
      "WRITE_EXTERNAL_STORAGE"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
